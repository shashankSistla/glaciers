setwd("C:\\Users\\shash\\OneDrive\\Desktop\\Research\\Glacier Revamp\\output\\debug\\04_candidate_paths")
debug = readRDS("output/G010748E46850N_sSmooth.rds")
debug$dd1[1]
restart$dd1[1]
# Load necessary libraries
library(RColorBrewer)
library(scales)
# Example data matrix dd1
dd1 <- debug$dd1
# Set quantile-based limits for the color scale
dmax <- quantile(abs(dd1), 0.99)
cols = colorRampPalette(c(muted("blue"), "grey", muted("red")))
col_pal = cols(64)
par(oma=c( 0,1,0,0))
dmax = quantile(abs(dd1), .99)
dd1[which(dd1 > dmax)] = dmax
dd1[which(dd1 < -dmax)] = -dmax
# Plot setup
par(oma = c(0, 1, 0, 0))  # Adjust outer margins if necessary
# Matrix plot
image(1:nrow(dd1), 1:ncol(dd1), dd1, col = col_pal, axes = FALSE,
xlab = "", ylab = "", main = "Matrix Visualization")
