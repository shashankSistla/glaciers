library(deSolve)
setwd("C:\\Users\\shash\\OneDrive\\Desktop\\Research\\Glacier Revamp")
source("PCODE.R")
library(deSolve)
library(fda)
library(MASS)
library(pracma)
library(Hmisc)
#set seed for reproducibility
set.seed(123)
ode.model <- function(t,state,parameters){
with(as.list(c(state,parameters)),{
dX <- theta*X*(1-X/10)
return(list(dX))})}
model.par   <- c(theta = c(0.1))
#define state initial value
state       <- c(X     = 0.1)
times  <- seq(0,100,length.out=101)
mod    <- ode(y=state,times=times,func=ode.model,parms = model.par)
nobs   <- length(times)
scale  <- 0.5
noise  <- scale * rnorm(n = nobs, mean = 0 , sd = 1)
observ <- mod[,2] + noise
plot(mod,ylab=names(state))      #curve
points(times, observ,pch='*',col='blue')    #observation
#Generate basis object for interpolation and as argument of pcode
#21 konts equally spaced within [0,100]
knots <- seq(0,100,length.out=21)
#order of basis functions
norder <- 4
#number of basis funtions
nbasis <- length(knots) + norder - 2
#creating Bspline basis
basis  <- create.bspline.basis(c(0,100),nbasis,norder,breaks = knots)
fit = mgcv::gam(observ ~ s(times, bs = "cr", k = -1))
plot(times, observ, col= "grey", main = "GAM");
lines(times, fit$linear.predictors, col = 2, lwd = 2)
abline(v = fit$smooth[[1]]$xp, lty = 2)
res = get_gam_fda_coeffs(fit, times, range(times))
coef_mat = res$coefficients_matrix
bspline_basis = res$bspline_basis
gam_coefs = fit$coefficients
fda_basis_eval <- eval.basis(times, bspline_basis)
fda_fitted_values <- fda_basis_eval %*% coef_mat %*% gam_coefs
plot(times, observ, col= "grey", main = "FDA");
lines(times, fda_fitted_values, col = 2, lwd = 2)
abline(v = fit$smooth[[1]]$xp, lty = 2)
#parameter estimation
pcode.result <- pcode(data = observ, time = times, ode.model = ode.model,
par.initial = 0.3, par.names = 'theta',state.names = 'X',
basis.list = basis, lambda = 1e2, gam_coefs = gam_coefs )
