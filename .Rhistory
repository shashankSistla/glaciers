library(mgcv)
library(fda)
# Set seed for reproducibility
set.seed(123)
# Prepare data
x <- seq(0, 10, length.out = 100)
y <- sin(x) + rnorm(100, sd = 0.2)
# Define knots at the deciles of x
quantile_knots <- quantile(x, probs = seq(0, 1, length.out = 11))
# Fit a GAM model with specified knots
gam_model <- gam(y ~ s(x, bs = "cr", k = -1) - 1, data = data.frame(x, y))
# Predictions from the GAM model
gam_predictions <- predict(gam_model, type = "response")
# Plot the fit directly using mgcv
plot(x, y, main = "Fit using mgcv", xlab = "x", ylab = "y", pch = 20, col = "gray")
lines(x, gam_predictions, col = "blue", lwd = 2)
# Get the basis functions used in GAM
basis_gam <- predict(gam_model, type = "lpmatrix")
gam_coefs <- coef(gam_model)  # Extract coefficients for GAM basis functions
# Create a B-spline basis using 'fda' with knots also at quantiles
bspline_basis <- create.bspline.basis(rangeval = range(x), breaks = quantile_knots, norder = 4)
# Evaluate the 'fda' basis functions at each x
fda_basis_eval <- eval.basis(x, bspline_basis)
# Initialize matrix to store coefficients
coefficients_matrix <- matrix(nrow = ncol(fda_basis_eval), ncol = ncol(basis_gam))
# Fit each 'mgcv' basis function to the 'fda' basis functions
for (i in 1:ncol(basis_gam)) {
fit <- lm(basis_gam[, i] ~ fda_basis_eval - 1)  # Fit without intercept
coefficients_matrix[1:length(coef(fit)), i] <- coef(fit)
}
# Reconstruct the fitted values using the FDA basis functions and GAM model coefficients
fda_fitted_values <- fda_basis_eval %*% coefficients_matrix %*% gam_coefs
# Plot the fit using the FDA basis functions
plot(x, y, main = "Fit using FDA basis functions", xlab = "x", ylab = "y", pch = 20, col = "gray")
lines(x, fda_fitted_values, col = "red", lwd = 2)
