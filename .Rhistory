# Define the ODE system
ode_system <- function(T, state, parameters) {
with(as.list(c(state, parameters)), {
dX <- alpha * X * (1 - X / 10) + beta * sin(Y)
dY <- 0  # Assuming Y does not change over time for simplicity
return(list(c(dX, dY)))
})
}
# Initial conditions and parameters
state_initial <- c(X = 1, Y = pi / 4)  # Example initial conditions
parameters <- c(alpha = 0.1, beta = 0.05)  # Example parameter values
times <- seq(0, 100, by = 1)  # Time from 0 to 100 in steps of 1
# Solve the ODE
solution <- ode(y = state_initial, times = times, func = ode_system, parms = parameters)
# Plot the solution for X over time
plot(solution, main = "Solution for X", ylab = "X", xlab = "Time")
# Plot the solution for X over time
plot(solution, ylab = "X", xlab = "Time")
